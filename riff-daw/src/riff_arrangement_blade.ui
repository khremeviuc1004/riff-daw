<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkImage" id="add_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="add_symbol1">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="add_symbol2">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="copy_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="delete_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="image1">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="play_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkAdjustment" id="riff_arr_horizontal_adjustment">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkImage" id="save_image">
    <property name="visible">True</property>
  </object>
  <object class="GtkFrame" id="riff_arrangement_blade">
    <property name="visible">True</property>
    <property name="margin-start">10</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <property name="label-xalign">0</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="margin-bottom">3</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <child>
              <object class="GtkViewport">
                <property name="visible">True</property>
                <child>
                  <object class="GtkGrid">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkEntry" id="riff_arrangement_name_entry">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="width-chars">15</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_arrangement_blade_play">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_arrangement_blade_copy">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_arrangement_blade_delete">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Riff Set</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="add_riff_set_btn">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Sequence</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="riff_sequence_combobox">
                        <property name="name">riff_arr_riff_seq_combo</property>
                        <property name="width-request">100</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="add_riff_sequence_btn">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_arrangement_copy_to_track_view_btn">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Grid</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="riff_grid_combobox">
                        <property name="name">riff_arr_riff_grid_combo</property>
                        <property name="width-request">100</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="add_riff_grid_btn">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_arrangement_save_name_btn">
                        <property name="visible">True</property>
                        <property name="tooltip-text" translatable="yes">Save the updated riff name</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="riff_set_combobox">
                        <property name="name">riff_arr_riff_set_combo</property>
                        <property name="width-request">100</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="riff_arrangement_scrolled_window">
            <property name="name">riff_arrangement_riff_items_scrolled_window</property>
