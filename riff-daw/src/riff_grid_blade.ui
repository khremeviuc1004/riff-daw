<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkImage" id="copy_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="delete_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="image1">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="image2">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="play_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkAdjustment" id="riff_grid_horizontal_adjustment">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkImage" id="select_symbol">
    <property name="visible">True</property>
    <property name="halign">start</property>
  </object>
  <object class="GtkFrame" id="riff_grid_blade">
    <property name="name">riff_grid_blade</property>
    <property name="visible">True</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <property name="label-xalign">0</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="margin-bottom">3</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkGrid">
            <property name="height-request">31</property>
            <property name="visible">True</property>
            <property name="halign">start</property>
            <property name="valign">start</property>
            <property name="margin-top">3</property>
            <property name="margin-bottom">63</property>
            <child>
              <object class="GtkEntry" id="riff_grid_name_entry">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="width-chars">15</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="riff_grid_blade_play">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="riff_grid_blade_copy">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="riff_grid_blade_delete">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="riff_grid_copy_to_track_view_btn">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="riff_grid_drag_btn">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="riff_grid_select_btn">
                <property name="visible">True</property>
                <property name="halign">start</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <placeholder />
            </child>
            <child>
              <placeholder />
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="riff_grid_scrolled_window">
            <property name="name">riff_grid_riff_set_heads_scrolled_window</property>
            <property name="width-request">300</property>
            <property name="visible">True</property>
            <property name="margin-top">1</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="hadjustment">riff_grid_horizontal_adjustment</property>
            <property name="vscrollbar-policy">external</property>
            <property name="propagate-natural-height">True</property>
            <child>
              <object class="GtkViewport" id="riff_grid_view_port">
                <property name="visible">True</property>
                <child>
                  <object class="GtkDrawingArea" id="riff_grid_drawing_area">
                    <property name="width-request">1000</property>
                    <property name="visible">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="label">
      <object class="GtkLabel">
        <property name="visible">True</property>
        <property name="label" translatable="yes">Riff Grid</property>
      </object>
    </child>
  </object>
</interface>