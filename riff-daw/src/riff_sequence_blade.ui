<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkImage" id="add_symbol">
    <property name="visible">True</property>
    <property name="halign">start</property>
  </object>
  <object class="GtkImage" id="copy_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="delete_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="image1">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="image2">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="play_symbol">
    <property name="visible">True</property>
  </object>
  <object class="GtkAdjustment" id="riff_seq_horizontal_adjustment">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkImage" id="save_image">
    <property name="visible">True</property>
  </object>
  <object class="GtkImage" id="select_symbol">
    <property name="visible">True</property>
    <property name="halign">start</property>
  </object>
  <object class="GtkFrame" id="riff_sequence_blade">
    <property name="name">riff_sequence_blade</property>
    <property name="visible">True</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <property name="label-xalign">0</property>
    <child>
      <object class="GtkBox" id="riff_sequence_blade_top_box">
        <property name="visible">True</property>
        <property name="margin-bottom">3</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkScrolledWindow" id="riff_sequence_controls_scrolled_window">
            <property name="visible">True</property>
            <child>
              <object class="GtkViewport">
                <property name="visible">True</property>
                <child>
                  <object class="GtkGrid">
                    <property name="visible">True</property>
                    <property name="halign">start</property>
                    <property name="valign">start</property>
                    <child>
                      <object class="GtkEntry" id="riff_sequence_name_entry">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="width-chars">15</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                          <property name="column-span">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_blade_play">
                        <property name="icon-name">media-playback-start</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">4</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_blade_copy">
                        <property name="icon-name">edit-copy</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">5</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_blade_delete">
                        <property name="icon-name">edit-delete</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">6</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="riff_sequence_riff_set_combobox_label">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="yes">Riff Set</property>
                        <layout>
                          <property name="column">9</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="add_riff_set_btn">
                        <property name="icon-name">list-add</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">11</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_copy_to_track_view_btn">
                        <property name="icon-name">format-justify-left</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">7</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_drag_btn">
                        <property name="icon-name">go-jump</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">8</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_select_btn">
                        <property name="icon-name">edit-select-all</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">12</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="riff_sequence_save_name_btn">
                        <property name="icon-name">document-save</property>
                        <property name="visible">True</property>
                        <property name="tooltip-text" translatable="yes">Save the updated riff name</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">3</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="riff_set_combobox">
                        <property name="name">riff_seq_riff_set_combo</property>
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <layout>
                          <property name="column">10</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="name">riff_sequence_riff_set_heads_scrolled_window</property>
