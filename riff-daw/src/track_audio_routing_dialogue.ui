<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="track_audio_routing_dialogue">
    <property name="height-request">600</property>
    <property name="title" translatable="yes">Audio Routes</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkButton" id="track_audio_routing_close_button">
                <property name="label" translatable="yes">_Close</property>
                <property name="visible">True</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Add Destination</property>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="track_audio_routing_track_combobox_text">
                <property name="visible">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="track_audio_routing_add_track_button">
                <property name="visible">True</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">list-add</property>
                    <property name="visible">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">True</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkViewport">
                <property name="visible">True</property>
                <child>
                  <object class="GtkBox" id="track_audio_routing_scrolled_box">
                    <property name="visible">True</property>
